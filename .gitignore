# ==============================
# SupplyMind AI - Git Ignore
# ==============================

# Maven build output
backend/target/

# Runtime business data
backend/data/
backend/data.__manual_startup_backup__/

# Logs
backend/logs/
logs/

# Temporary review/work directories
.codex-doc-review/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Local environment / secrets
.env
.env.*
application-local.yml
application-local.yaml
application-local.properties

.playwright-mcp/

# D9 desktop build output (electron dist / node deps installed locally)
desktop/node_modules/
desktop/dist/

# D9 portable package assembly (built by desktop/scripts, never committed)
portable/

# D9 final release artifacts (ZIP + checksum, built by package-final.ps1)
release/

# D9 smoke scratch data at repo root (desktop/scripts smoke runs)
target/
